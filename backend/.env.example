APP_NAME="Sevgi Butik"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=tr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=tr_TR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=butik
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

# Domains allowed to authenticate via Sanctum's SPA cookie mode. Must match
# the Next.js dev server origin(s) exactly, including port.
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
FRONTEND_URL=http://localhost:3000

# Password the admin seeder (DatabaseSeeder) hashes for the seeded admin
# account. Set this before running `php artisan migrate --seed`; if it's
# unset, the seeder hashes a random string instead of shipping a default.
ADMIN_SEED_PASSWORD=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS="bilgi@sevgibutik.com"
MAIL_FROM_NAME="${APP_NAME}"

# NETGSM_DRIVER=log writes OTP codes to storage/logs/laravel.log instead of
# sending a real SMS. Set to "api" and fill in usercode/password/header once
# you have a Netgsm account to send real password-reset texts.
NETGSM_DRIVER=log
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_HEADER=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Shop settings (config/shop.php)
FREE_SHIPPING_THRESHOLD_MINOR=250000
FLAT_SHIPPING_MINOR=5000
